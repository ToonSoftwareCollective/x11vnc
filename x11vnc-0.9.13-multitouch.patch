+		ev_send(d, EV_ABS, ABS_MT_TRACKING_ID, -1);
+		ev_send(d, EV_KEY, BTN_TOUCH, 0);
+		ev_send(d, EV_ABS, ABS_MT_TOUCH_MAJOR, 0);
+		ev_send(d, EV_ABS, ABS_PRESSURE, 0);
+		ev_send(d, EV_SYN, SYN_REPORT, 0);
